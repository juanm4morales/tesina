\contentsline {figure}{\numberline {2.3}{\ignorespaces Relaciones temporales y espaciales entre vehículos consecutivos de una corriente de tránsito: intervalo ($h$) y espaciamiento ($s$).}}{11}{figure.caption.22}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Comparación esquemática de distribuciones de intervalos temporales entre vehículos en flujo libre y en una corriente con formación de agrupamientos vehiculares. Las curvas representan situaciones conceptuales y no una distribución empírica particular.}}{13}{figure.caption.29}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Distribución temporal de la tasa de descarga y pérdidas asociadas durante un intervalo de verde en una aproximación semaforizada.}}{15}{figure.caption.32}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Correspondencia entre la circulación real y su representación en SUMO}}{17}{figure.caption.35}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Interfaz sumo-gui durante una simulación microscópica}}{18}{figure.caption.36}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Esquema conceptual de carriles, línea de detención y conexiones de una intersección semaforizada bajo circulación por la derecha. La fase representada habilita movimientos directos opuestos del eje horizontal y retiene los movimientos conflictivos.}}{20}{figure.caption.38}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Interacción agente-entorno en un proceso de decisión de Markov \cite {suttonRL}.}}{24}{figure.caption.44}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Esquema de un método basado en valor}}{26}{figure.caption.48}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Esquema de un método basado en política}}{27}{figure.caption.51}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces Arquitectura actor-crítico aplicada al control semafórico}}{29}{figure.caption.55}%
\contentsline {figure}{\numberline {2.13}{\ignorespaces Operaciones de una unidad neuronal artificial: suma ponderada de las entradas, incorporación del sesgo y aplicación de una función de activación.}}{30}{figure.caption.58}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces Arquitectura conceptual de una red neuronal \textit {feedforward} con dos capas ocultas.}}{31}{figure.caption.61}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces Flujo conceptual de \acrshort {acr-dqn} con repetición de experiencias y red objetivo. La red en línea selecciona acciones y recibe las actualizaciones; la red objetivo proporciona el término de \textit {bootstrapping} del valor objetivo \gls {acr-td}. Elaboración propia a partir del algoritmo descrito por Mnih et al. \cite {mnih2015}.}}{34}{figure.caption.67}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces Red de política para un espacio discreto de acciones}}{36}{figure.caption.72}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces Interacción agente-entorno en MARL cooperativo}}{41}{figure.caption.87}%
\contentsline {figure}{\numberline {2.18}{\ignorespaces Evolución de las políticas de dos agentes bajo WoLF-PHC en Piedra, Papel o Tijera}}{43}{figure.caption.91}%
\contentsline {figure}{\numberline {2.19}{\ignorespaces Paradigma de entrenamiento centralizado con ejecución descentralizada (\acrshort {acr-ctde}). Durante el entrenamiento, el crítico utiliza información global privilegiada para estimar valores o ventajas que orientan la actualización de los actores locales; durante la ejecución, los actores solo requieren observaciones locales.}}{44}{figure.caption.94}%
\contentsline {figure}{\numberline {2.20}{\ignorespaces Esquema de actualización secuencial de \acrshort {acr-happo}. A diferencia de \acrshort {acr-ppo} independiente, la actualización de cada agente está condicionada por el factor de ventaja reponderada $M_{i_m}$, que incorpora los cambios efectuados por los agentes que lo precedieron en la secuencia.}}{51}{figure.caption.115}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Geometría de las tres redes de tráfico sintéticas. Los puntos marcan intersecciones semaforizadas; cada panel usa una escala propia.}}{63}{figure.caption.131}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Red de tráfico parcial del microcentro de Mendoza. Los extremos grises conectan con la red de tráfico circundante; el tramo azul identifica el ingreso representado por el registro de la cámara 169, que observa el flujo hacia el oeste por Av. José Vicente Zapata.}}{65}{figure.caption.136}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Flujo entre la simulación, el entorno y el aprendizaje. El estado de SUMO y los parámetros de las políticas se almacenan por separado.}}{69}{figure.caption.148}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces La observación conserva la fase activa y codifica la espera de cada carril en niveles discretos.}}{72}{figure.caption.156}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Información de los algoritmos durante el entrenamiento y la ejecución. Cada algoritmo y agente tiene su propia política; el crítico centralizado de MAPPO y HAPPO no interviene al ejecutar. En C, el actor recibe además la espera media por carril codificada de cada vecino directo.}}{75}{figure.caption.164}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Búsqueda en dos fases: la primera orienta la reducción de dominios de la segunda.}}{78}{figure.caption.172}%
