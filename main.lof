\contentsline {figure}{\numberline {2.8}{\ignorespaces Esquema conceptual de carriles, línea de detención y conexiones de una intersección semaforizada bajo circulación por la derecha. La fase representada habilita movimientos directos opuestos del eje horizontal y retiene los movimientos conflictivos.}}{20}{figure.caption.38}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Interacción agente-entorno en un proceso de decisión de Markov \cite {suttonRL}.}}{24}{figure.caption.44}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Esquema de un método basado en valor}}{26}{figure.caption.48}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Esquema de un método basado en política}}{27}{figure.caption.51}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces Arquitectura actor-crítico aplicada al control semafórico}}{29}{figure.caption.55}%
