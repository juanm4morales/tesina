\contentsline {figure}{\numberline {1.1}{\ignorespaces Evolución de la flota vehicular circulante en Argentina (1990--2025). Datos: AFAC.}}{1}{figure.caption.13}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Movimientos vehiculares, fases y cruces peatonales}}{6}{figure.caption.18}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Representación esquemática de movimientos vehiculares y puntos de conflicto en una intersección semaforizada.}}{6}{figure.caption.19}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Relaciones temporales y espaciales entre vehículos consecutivos de una corriente de tránsito: intervalo ($h$) y espaciamiento ($s$).}}{9}{figure.caption.22}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Comparación esquemática de distribuciones de intervalos temporales entre vehículos en flujo libre y en una corriente con formación de pelotones. Las curvas representan situaciones conceptuales y no una distribución empírica particular.}}{12}{figure.caption.29}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Distribución temporal de la tasa de descarga y pérdidas asociadas durante un intervalo de verde en una aproximación semaforizada.}}{13}{figure.caption.32}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Correspondencia conceptual entre una situación real de circulación vehicular y su representación microscópica en un simulador. Elaboración propia.}}{15}{figure.caption.35}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Interfaz gráfica de SUMO durante la ejecución de una simulación microscópica, con visualización de la red y de variables del vehículo.}}{16}{figure.caption.36}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Esquema conceptual de carriles, línea de detención y conexiones de una intersección semaforizada bajo circulación por la derecha. La fase representada habilita movimientos directos opuestos del eje horizontal y retiene los movimientos conflictivos.}}{17}{figure.caption.38}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Interacción agente-entorno en un proceso de decisión de Markov \cite {suttonRL}.}}{21}{figure.caption.44}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Arquitectura actor-crítico aplicada al control semafórico. El actor selecciona una acción y el crítico evalúa la transición para construir la señal que actualiza ambos componentes. Elaboración propia a partir de \cite {konda2003actorcritic,suttonRL}.}}{24}{figure.caption.53}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Relación entre las familias de algoritmos utilizadas en esta investigación. Los cuatro métodos evaluados son libres de modelo y se derivan de las líneas DQN y PPO.}}{25}{figure.caption.54}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces Operaciones de una unidad neuronal artificial: combinación afín de las entradas y aplicación de una función de activación.}}{26}{figure.caption.58}%
\contentsline {figure}{\numberline {2.13}{\ignorespaces Arquitectura conceptual de una red neuronal \textit {feedforward}. Cada columna representa una capa y las conexiones se dirigen desde la entrada hacia la salida; las expresiones inferiores indican la transformación afín seguida de la activación en cada capa.}}{27}{figure.caption.60}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces Flujo conceptual de DQN con repetición de experiencias y red objetivo. La red en línea selecciona acciones y recibe las actualizaciones; la red objetivo proporciona el término de \textit {bootstrapping} del blanco \gls {acr-td}. Elaboración propia a partir del algoritmo descrito por Mnih et al. \cite {mnih2015}.}}{30}{figure.caption.66}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces Red de política para un espacio discreto de fases. La observación determina una distribución de acciones; durante el aprendizaje, la ventaja pondera el gradiente de la log-probabilidad de la acción seleccionada \cite {suttonRL,konda2003actorcritic}.}}{32}{figure.caption.70}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces Interacción agente-entorno en MARL cooperativo}}{37}{figure.caption.85}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces Evolución de las políticas de dos agentes bajo WoLF-PHC en Piedra, Papel o Tijera}}{38}{figure.caption.88}%
\contentsline {figure}{\numberline {2.18}{\ignorespaces Paradigma de Entrenamiento Centralizado y Ejecución Descentralizada (CTDE). Durante el entrenamiento, el crítico utiliza información global privilegiada para estimar valores o ventajas que orientan la actualización de los actores locales; durante la ejecución, los actores solo requieren observaciones locales.}}{40}{figure.caption.92}%
\contentsline {figure}{\numberline {2.19}{\ignorespaces Esquema de actualización secuencial de HAPPO. A diferencia de PPO independiente, la actualización de cada agente está condicionada por el factor de ventaja reponderada $M_{i_m}$, que incorpora los cambios efectuados por los agentes que lo precedieron en la secuencia.}}{46}{figure.caption.113}%
