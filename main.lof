\contentsline {figure}{\numberline {1.1}{\ignorespaces Evolución de la flota vehicular circulante en Argentina (1990--2025). Datos: AFAC.}}{2}{figure.caption.10}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Convención esquemática de movimientos vehiculares, fases y cruces peatonales concurrentes en una intersección de cuatro accesos, adaptada conceptualmente del manual de temporización semafórica de FHWA \cite {fhwa_signal_timing_manual}.}}{5}{figure.caption.11}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Representación esquemática de movimientos vehiculares y puntos de conflicto en una intersección semaforizada.}}{5}{figure.caption.12}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Relaciones temporales y espaciales entre vehículos consecutivos de una corriente de tránsito: intervalo ($h$) y espaciamiento ($s$).}}{7}{figure.caption.14}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Comparación esquemática de la distribución de intervalos temporales entre vehículos en flujo libre (exponencial negativa, consistente con el proceso de Poisson) y en flujo coordinado por semáforos (distribución desplazada con zona de exclusión física $t_{\min }$ y pico característico de pelotón).}}{9}{figure.caption.17}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Distribución temporal de la tasa de descarga y pérdidas asociadas durante un intervalo de verde en una aproximación semaforizada.}}{10}{figure.caption.19}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Elementos geométricos y conexiones de una intersección semaforizada en SUMO bajo sentido de circulación por la derecha (Argentina): carriles entrantes ($L_{\text {in}}$), salientes ($L_{\text {out}}$), líneas de detención y enlaces de cruzamiento (\textit {links}) en verde prioritario (\textbf {G}) y rojo retenido en conflicto (\textbf {r}).}}{12}{figure.caption.22}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Interacción agente-entorno en un proceso de decisión de Markov \cite {suttonRL}.}}{15}{figure.caption.26}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Taxonomía de algoritmos de Aprendizaje por Refuerzo, enfocada en métodos \textit {Model-Free} (adaptada de OpenAI \textit {Spinning Up} \cite {spinningup}).}}{16}{figure.caption.27}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Interacción Agente-Entorno en un esquema MARL cooperativo. Cada semáforo emite una acción local ($a_i$) formando una acción conjunta ($\mathbf {a}$) que modifica el estado global del entorno de tráfico.}}{22}{figure.caption.34}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Paradigma de Entrenamiento Centralizado y Ejecución Descentralizada (CTDE). El Crítico utiliza información global privileged para guiar las actualizaciones de los Actores locales durante la simulación.}}{24}{figure.caption.36}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Esquema de actualización secuencial de HAPPO. A diferencia de PPO Independiente, la actualización de cada agente está matemáticamente condicionada por el cociente de probabilidad compuesto $M_{i_m}$, que propaga los cambios efectuados por los agentes que lo precedieron en la secuencia.}}{29}{figure.caption.42}%
